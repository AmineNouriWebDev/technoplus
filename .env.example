# ========================================
# Configuration Base de Données - PRODUCTION
# ========================================
DB_HOST_PROD=localhost
DB_USER_PROD=votre_utilisateur_prod
DB_PASS_PROD=votre_mot_de_passe_prod
DB_NAME_PROD=technopl_db

# ========================================
# Chemins du Site
# ========================================
SITE_URL_LOCAL=http://localhost/technoplus/
